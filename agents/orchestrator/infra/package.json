  "dependencies": {
    "@aws/agentcore-cdk": "0.1.0-alpha.31",
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.5.0"
  },
  "devDependencies": {
    "yaml": "^2.8.2",
    "@types/node": "^24.10.1",
    "aws-cdk": "^2.1124.0",
    "typescript": "~5.9.3"
  }
}
