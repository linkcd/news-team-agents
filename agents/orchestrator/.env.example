# Orchestrator Agent - Environment Variables
# Copy this file to .env for local development

# ============================================================================
# AWS Configuration
# ============================================================================
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=eu-west-1

# ============================================================================
# Model Configuration
# ============================================================================
# Claude model ID for orchestration decisions
# Default: global.anthropic.claude-sonnet-4-6
MODEL_ID=global.anthropic.claude-sonnet-4-6

# ============================================================================
# AgentCore Runtime Configuration
# ============================================================================
# ARNs of the deployed Collector and Publisher agents
# These are required for the orchestrator to invoke the downstream agents
COLLECTOR_RUNTIME_ARN=arn:aws:bedrock-agentcore:eu-west-1:548129671048:runtime/newscollector_NewsCollector-EhrHzp4oFi
PUBLISHER_RUNTIME_ARN=arn:aws:bedrock-agentcore:eu-west-1:548129671048:runtime/newspublisher_NewsPublisher-OZnqGfD4D2

# ============================================================================
# S3 Bucket Configuration
# ============================================================================
# Bucket for intermediate data storage between agents
# Default: news-agent-data-548129671048
S3_BUCKET=news-agent-data-548129671048

# ============================================================================
# Notes:
# ============================================================================
# Required AWS permissions:
# - bedrock-agentcore:InvokeAgentRuntime (on Collector and Publisher)
# - bedrock:InvokeModel (for reasoning/decisions)
#
# IMPORTANT: Collector and Publisher must be deployed first before running
# the orchestrator. Update the runtime ARNs above with your deployed values:
#   1. Deploy Collector: cd agents/collector && agentcore deploy -y
#   2. Deploy Publisher: cd agents/publisher && agentcore deploy -y
#   3. Get ARNs from deployment output
#   4. Update this .env file with the ARNs
#   5. Deploy Orchestrator: cd agents/orchestrator && agentcore deploy -y
