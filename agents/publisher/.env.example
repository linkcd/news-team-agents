# Publisher Agent - Environment Variables
# Copy this file to .env for local development

# ============================================================================
# AWS Configuration
# ============================================================================
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=eu-west-1

# ============================================================================
# Model Configuration
# ============================================================================
# Claude model ID for markdown generation and summary writing
# Default: global.anthropic.claude-sonnet-4-6
MODEL_ID=global.anthropic.claude-sonnet-4-6

# ============================================================================
# Notes:
# ============================================================================
# Required AWS permissions:
# - bedrock:InvokeModel (for LLM operations)
# - s3:GetObject (for reading collected content)
# - Outbound internet access (for git push and GitHub API)
#
# GitHub token for git authentication is injected at runtime via
# AgentCore Identity (@requires_api_key decorator) - not needed in .env
