# Collector Agent - Environment Variables
# Copy this file to .env for local development

# ============================================================================
# AWS Configuration
# ============================================================================
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=eu-west-1

# ============================================================================
# Model Configuration
# ============================================================================
# Claude model ID for content consolidation, translation, and summarization
# Default: global.anthropic.claude-sonnet-4-6
MODEL_ID=global.anthropic.claude-sonnet-4-6

# ============================================================================
# Notes:
# ============================================================================
# Required AWS permissions:
# - bedrock:InvokeModel (for LLM operations)
# - s3:PutObject (for writing results)
# - Outbound internet access (for RSS feeds and article URLs)
#
# GitHub token for private repo access is injected at runtime via
# AgentCore Identity (@requires_api_key decorator) - not needed in .env
