# News Team Agents - Root Environment Variables
# Copy this file to .env and fill in the values for local development

# ============================================================================
# AWS Configuration
# ============================================================================
# AWS credentials (required for boto3 to access S3, Bedrock, AgentCore)
# You can also use AWS CLI profiles instead: export AWS_PROFILE=your-profile
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=eu-west-1

# ============================================================================
# Optional: Model Configuration
# ============================================================================
# Override the default model ID for all agents
# Default: global.anthropic.claude-sonnet-4-6
# MODEL_ID=global.anthropic.claude-sonnet-4-6

# ============================================================================
# Notes:
# ============================================================================
# - Each agent subfolder (agents/collector, agents/publisher, agents/orchestrator)
#   can have its own .env file with agent-specific overrides
# - AWS credentials can also come from:
#   * IAM roles (when running on AWS)
#   * AWS CLI profiles (AWS_PROFILE environment variable)
#   * EC2 instance metadata
#   * ECS task roles
# - GitHub token is managed by AgentCore Identity (@requires_api_key decorator)
#   and does NOT need to be in .env
